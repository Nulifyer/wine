    NTSTATUS samr_unused_35(void);
    NTSTATUS samr_query_information_user(
        [in] SAMR_HANDLE user_handle,
        [in] SAMR_USER_INFORMATION_CLASS user_information_class,
        [out, switch_is(user_information_class)] SAMR_USER_INFO_BUFFER **buffer);
    NTSTATUS samr_unused_37(void);
    NTSTATUS samr_unused_38(void);
    NTSTATUS samr_unused_39(void);
    NTSTATUS samr_unused_40(void);
