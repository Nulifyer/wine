    NTSTATUS lsarpc_open_policy2(
        [in, unique, string] WCHAR *server_name,
        [in] LSARPC_OBJECT_ATTRIBUTES *attributes,
        [in] ULONG access,
        [out] LSARPC_HANDLE *handle);
    NTSTATUS lsarpc_get_user_name(
        [in, unique, string] WCHAR *server_name,
        [in, out] LSARPC_UNICODE_STRING **user_name,
        [in, out, unique] LSARPC_UNICODE_STRING **domain_name);
    NTSTATUS lsarpc_query_information_policy2(
        [in] LSARPC_HANDLE handle,
        [in] LSARPC_POLICY_INFORMATION_CLASS info_class,
        [out, switch_is(info_class)] LSARPC_POLICY_INFORMATION **info);
    /* Unsupported methods retain their protocol opnum positions. */
    NTSTATUS lsarpc_unused_47(void);
