#pragma makedep server

import "wtypes.idl";

cpp_quote("#include <winternl.h>")
cpp_quote("#define LSARPC_ENDPOINT {'L','S','A','R','P','C','_','E','N','D','P','O','I','N','T',0}")

[
    uuid(12345778-1234-abcd-ef00-0123456789ab),
    version(0.0),
    pointer_default(unique)
]
interface lsarpc
{
    cpp_quote("#if 0")
    typedef LONG NTSTATUS;
    cpp_quote("#endif")

    typedef [context_handle] void *LSARPC_HANDLE;

    typedef struct
    {
        USHORT Length;
        USHORT MaximumLength;
        [size_is(MaximumLength), length_is(Length)] char *Buffer;
    } LSARPC_STRING;

    typedef enum
    {
        LsarpcSecurityAnonymous,
        LsarpcSecurityIdentification,
        LsarpcSecurityImpersonation,
        LsarpcSecurityDelegation
    } LSARPC_SECURITY_IMPERSONATION_LEVEL;

    typedef struct
    {
        ULONG Length;
        LSARPC_SECURITY_IMPERSONATION_LEVEL ImpersonationLevel;
        BYTE ContextTrackingMode;
        BYTE EffectiveOnly;
    } LSARPC_SECURITY_QUALITY_OF_SERVICE;

    typedef struct
    {
        ULONG Length;
        [unique] BYTE *RootDirectory;
        [unique] LSARPC_STRING *ObjectName;
        ULONG Attributes;
        [unique] BYTE *SecurityDescriptor;
        [unique] LSARPC_SECURITY_QUALITY_OF_SERVICE *SecurityQualityOfService;
    } LSARPC_OBJECT_ATTRIBUTES;

    typedef struct
    {
        USHORT Length;
        USHORT MaximumLength;
        [size_is(MaximumLength / 2), length_is(Length / 2)] WCHAR *Buffer;
    } LSARPC_UNICODE_STRING;

    typedef enum
    {
        LsarpcPolicyAuditLogInformation = 1,
        LsarpcPolicyAuditEventsInformation,
        LsarpcPolicyPrimaryDomainInformation,
        LsarpcPolicyPdAccountInformation,
        LsarpcPolicyAccountDomainInformation,
        LsarpcPolicyLsaServerRoleInformation,
        LsarpcPolicyReplicaSourceInformation,
        LsarpcPolicyInformationNotUsedOnWire,
        LsarpcPolicyModificationInformation,
        LsarpcPolicyAuditFullSetInformation,
        LsarpcPolicyAuditFullQueryInformation,
        LsarpcPolicyDnsDomainInformation,
        LsarpcPolicyDnsDomainInformationInt,
        LsarpcPolicyLocalAccountDomainInformation,
        LsarpcPolicyMachineAccountInformation,
        LsarpcPolicyLastEntry
    } LSARPC_POLICY_INFORMATION_CLASS;

    typedef struct
    {
        LSARPC_UNICODE_STRING DomainName;
        SID *DomainSid;
    } LSARPC_POLICY_ACCOUNT_DOMAIN_INFO;

    typedef struct
    {
        LSARPC_UNICODE_STRING Name;
        LSARPC_UNICODE_STRING DnsDomainName;
        LSARPC_UNICODE_STRING DnsForestName;
        GUID DomainGuid;
        SID *Sid;
    } LSARPC_POLICY_DNS_DOMAIN_INFO;

    typedef [switch_type(LSARPC_POLICY_INFORMATION_CLASS)] union
    {
        [case(LsarpcPolicyAccountDomainInformation)]
            LSARPC_POLICY_ACCOUNT_DOMAIN_INFO AccountDomainInformation;
        [case(LsarpcPolicyDnsDomainInformation)]
            LSARPC_POLICY_DNS_DOMAIN_INFO DnsDomainInformation;
        [case(LsarpcPolicyDnsDomainInformationInt)]
            LSARPC_POLICY_DNS_DOMAIN_INFO DnsDomainInformationInt;
        [case(LsarpcPolicyLocalAccountDomainInformation)]
            LSARPC_POLICY_ACCOUNT_DOMAIN_INFO LocalAccountDomainInformation;
    } LSARPC_POLICY_INFORMATION;

    typedef struct
    {
        ULONG Revision;
        ULONG SupportedFeatures;
    } LSARPC_REVISION_INFO_V1;

    typedef [switch_type(ULONG)] union
    {
        [case(1)] LSARPC_REVISION_INFO_V1 V1;
    } LSARPC_REVISION_INFO;

    NTSTATUS lsarpc_close([in, out] LSARPC_HANDLE *handle);
    /* Unsupported methods retain their protocol opnum positions. */
    NTSTATUS lsarpc_unused_1(void);
    NTSTATUS lsarpc_unused_2(void);
    NTSTATUS lsarpc_unused_3(void);
    NTSTATUS lsarpc_unused_4(void);
